CC = gcc
CFLAGS = -Wall -g -MMD -MP

EXECUTABLE = recv send alarm handler segfault sigaction

all: $(EXECUTABLE)

recv: recv_signal.c
	$(CC) $(CFLAGS) $< -o $@

send: send_signal.c
	$(CC) $(CFLAGS) $< -o $@

alarm: signal_alarm.c
	$(CC) $(CFLAGS) $< -o $@

handler: signal_handler.c
	$(CC) $(CFLAGS) $< -o $@

segfault: signal_segfault.c
	$(CC) $(CFLAGS) $< -o $@

sigaction: signal_sigaction.c
	$(CC) $(CFLAGS) $< -o $@

# Pull in dependency info generated by -MMD
-include $(EXECUTABLE:=.d)

clean:
	rm -f $(EXECUTABLE) *.o *.d

.PHONY: all clean